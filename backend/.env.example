# 复制为 .env 后填写真实值：cp .env.example .env
# 本文件是仓库里唯一的配置模板，不含任何真实凭据；部署后由管理员自行填写。

# ---------- 服务 ----------
APP_NAME=Postroom
HOST=127.0.0.1
PORT=8077
RELOAD=false

# ---------- SMTP（全局默认，可留空） ----------
# 每个用户在网页「系统设置」里都能配置自己的 SMTP，配了就优先用用户自己的；
# 用户没配时回落到这里。所以只想给所有人共用一个发信通道 → 只填这里就够了。
# 常见服务商：smtp.zoho.com / smtp.gmail.com / smtp.qq.com / smtp.163.com
# 一般用 465 + SSL；若用 587 则改 SMTP_STARTTLS=true、SMTP_USE_SSL=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_STARTTLS=false
# 认证账号 + 应用专用密码（不要用账号主密码）
SMTP_USER=
SMTP_PASSWORD=
# 发件地址：多数服务商要求与认证账号一致，否则会拒发
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Postroom

# ---------- 多用户 / 登录 ----------
# 首次启动自动创建的管理员用户名（密码留空则随机生成并打印在控制台 / data/keys.txt）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
# 登录会话有效期（小时）
SESSION_TTL_HOURS=72
# 同一用户名 + IP 每小时最多登录尝试次数
LOGIN_RATE_LIMIT_PER_HOUR=20
# 会话令牌同时写入的 HttpOnly Cookie 名
SESSION_COOKIE_NAME=postroom_session

# ---------- 鉴权 ----------
# 管理员根密钥（可调用全部接口，包括密钥与用户管理）；留空则首次启动自动生成并写入 data/keys.txt
ADMIN_API_KEY=
# 首次启动时自动创建的 agent 密钥；留空则随机生成。不要写死固定值。
BOOTSTRAP_API_KEY=
RATE_LIMIT_PER_HOUR=120

# ---------- 测试收件人（控制台一键测试用，逗号分隔；留空则不显示该功能） ----------
TEST_RECIPIENTS=

# ---------- 站点页脚 / 备案号 ----------
# 页脚悬挂的备案号，例如：ICP_LICENSE=苏ICP备2026000000号
# 留空则页脚不渲染（仓库里不含任何人的备案信息，部署后自己填）
ICP_LICENSE=
# 备案号点击跳转地址，默认工信部备案管理系统
ICP_LICENSE_URL=https://beian.miit.gov.cn/

# ---------- 任务会话 / 免登录回复链接 ----------
# 生成回复链接用的对外地址；留空则自动使用当前请求的 host
PUBLIC_BASE_URL=
# 回复链接签名密钥；留空则自动生成并保存到 data/reply_secret.txt
REPLY_TOKEN_SECRET=
# 回复链接默认有效期（天）
REPLY_TOKEN_TTL_DAYS=30
# 单个任务下用户每小时最多回信条数
REPLY_RATE_LIMIT_PER_HOUR=60
# 单条会话消息最大字数
MESSAGE_MAX_CHARS=4000

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
